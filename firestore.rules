rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /clientes/{clienteId}
    // Fields: id, nome, telefone, email, dataInicio, proximoVencimento, valorMensal, status, origem, dispositivo, observacoes, historicoPagamentos, dataCriacao, uid
    //
    // Collection: /leads/{leadId}
    // Fields: id, nome, telefone, dataInicioTeste, dataFimTeste, status, origem, motivoNaoConversao, observacoes, uid
    //
    // Collection: /investimentos/{investimentoId}
    // Fields: id, data, plataforma, valor, observacoes, uid
    //
    // Collection: /templates/{templateId}
    // Fields: id, titulo, conteudo, categoria, uid
    //
    // Collection: /tasks/{taskId}
    // Fields: id, text, isCompleted, priority, createdAt, uid
    //
    // Collection: /users/{userId}
    // Fields: id, email, name, whatsapp, businessName, planId, subscriptionStatus, trialEndsAt, createdAt, isAdmin
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
          request.auth.token.email in [
            "admin@stormcrm.com.br", 
            "estrategistadigitaltonybala@gmail.com",
            "mariaveronicadarochasousaalves@gmail.com"
          ]
        );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCliente(data) {
      return hasRequiredFields(['id', 'nome', 'telefone', 'dataInicio', 'proximoVencimento', 'valorMensal', 'status', 'origem', 'uid']) &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() < 100 &&
             data.telefone is string && data.telefone.size() >= 8 && data.telefone.size() < 20 &&
             data.valorMensal is number && data.valorMensal >= 0 &&
             data.status in ['Ativo', 'Inativo', 'Cancelado'] &&
             data.origem in ['Organico', 'Ads', 'Indicacao'] &&
             data.uid == request.auth.uid;
    }

    function isValidLead(data) {
      return hasRequiredFields(['id', 'nome', 'telefone', 'dataInicioTeste', 'dataFimTeste', 'status', 'origem', 'uid']) &&
             data.nome is string && data.nome.size() > 0 && data.nome.size() < 100 &&
             data.status in ['Em Teste', 'Convertido', 'Nao Converteu', 'Expirado'] &&
             data.uid == request.auth.uid;
    }

    function isValidInvestimento(data) {
      return hasRequiredFields(['id', 'data', 'plataforma', 'valor', 'uid']) &&
             data.valor is number && data.valor >= 0 &&
             data.plataforma in ['Facebook', 'Google', 'TikTok', 'Influencer', 'Outros'] &&
             data.uid == request.auth.uid;
    }

    function isValidTemplate(data) {
      return hasRequiredFields(['id', 'titulo', 'conteudo', 'categoria', 'uid']) &&
             data.titulo is string && data.titulo.size() > 0 && data.titulo.size() < 100 &&
             data.categoria in ['Boas-vindas', 'Cobranca', 'Suporte', 'Vendas'] &&
             data.uid == request.auth.uid;
    }

    function isValidTask(data) {
      return hasRequiredFields(['id', 'text', 'isCompleted', 'priority', 'createdAt', 'uid']) &&
             data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
             data.priority in ['Alta', 'Media', 'Baixa'] &&
             data.uid == request.auth.uid;
    }

    function isValidIndicacao(data) {
      return hasRequiredFields(['id', 'clienteIndicadorId', 'clienteIndicadoId', 'dataIndicacao', 'statusRecompensa', 'uid']) &&
             data.statusRecompensa in ['Pendente', 'Entregue'] &&
             data.uid == request.auth.uid;
    }

    function isValidTransaction(data) {
      return hasRequiredFields(['id', 'userId', 'userName', 'planId', 'amount', 'date', 'status', 'method']) &&
             data.status in ['paid', 'pending', 'failed', 'refunded'] &&
             data.method in ['pix', 'credit_card'];
    }

    function isValidUser(data) {
      return hasRequiredFields(['id', 'email', 'planId', 'subscriptionStatus', 'trialEndsAt']) &&
             data.email is string && data.email.size() > 0 &&
             data.planId in ['starter', 'professional', 'enterprise'] &&
             data.subscriptionStatus in ['trial', 'active', 'expired', 'canceled', 'suspended'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /clientes/{clienteId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidCliente(request.resource.data);
      allow update: if isDocOwner() && isValidCliente(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidLead(request.resource.data);
      allow update: if isDocOwner() && isValidLead(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /investimentos/{investimentoId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidInvestimento(request.resource.data);
      allow update: if isDocOwner() && isValidInvestimento(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /templates/{templateId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTemplate(request.resource.data);
      allow update: if isDocOwner() && isValidTemplate(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTask(request.resource.data);
      allow update: if isDocOwner() && isValidTask(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /indicacoes/{indicacaoId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidIndicacao(request.resource.data);
      allow update: if isDocOwner() && isValidIndicacao(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTransaction(request.resource.data);
      allow update: if isAdmin() && isValidTransaction(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.isAdmin == false || isAdmin());
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.isAdmin == resource.data.isAdmin || isAdmin());
      allow delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
